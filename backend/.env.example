# Шаблон настроек. Скопируйте файл в .env и при необходимости заполните.
# Настоящий .env в git не попадает — он добавлен в .gitignore.

# Адрес TheMealDB (можно не менять).
THEMEALDB_URL=https://www.themealdb.com/api/json/v1/1

# Ключ нужен только платному тарифу TheMealDB (v2). Для бесплатного v1
# не требуется, поле оставлено на будущее.
THEMEALDB_API_KEY=
